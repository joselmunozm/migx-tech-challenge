# Sent as the X-API-Key header. The Streamlit app reads the same value.
API_KEY=dev-local-key
API_BASE_URL=http://127.0.0.1:8000

# Embeddings. embed-v4.0, 1024 dimensions. Documents and queries use different input types.
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v4.0
EMBED_DIMENSION=1024

# Chat model. The default is a free OpenRouter variant (50 requests/day until credits are purchased).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# Retrieval configuration selected in the BioASQ subset experiment.
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=3
MIN_SIMILARITY=0.3

# Optional. When these are empty the app still runs and simply does not send traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
